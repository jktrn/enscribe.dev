{
  "name": "@enscribe/linebreak",
  "version": "0.2.0",
  "description": "Knuth\u2013Plass line breaking for the web",
  "keywords": [
    "knuth-plass",
    "line-breaking",
    "justification",
    "typography",
    "hyphenation",
    "text-layout",
    "typesetting",
    "tex"
  ],
  "type": "module",
  "license": "MIT",
  "author": "jktrn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktrn/enscribe.dev.git",
    "directory": "packages/linebreak"
  },
  "homepage": "https://github.com/jktrn/enscribe.dev/tree/main/packages/linebreak#readme",
  "bugs": {
    "url": "https://github.com/jktrn/enscribe.dev/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./attributes": {
      "types": "./dist/attributes.d.ts",
      "default": "./dist/attributes.js"
    },
    "./hyphenation": {
      "types": "./dist/hyphenation.d.ts",
      "default": "./dist/hyphenation.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "hyphen": "1.14.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/hyphen": "1.14.0",
    "publint": "0.3.21",
    "tsdown": "0.22.12",
    "typescript": "6.0.2"
  }
}
