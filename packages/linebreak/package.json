{
  "name": "@enscribe/linebreak",
  "version": "0.1.0",
  "description": "Browser-first Knuth–Plass line breaking for rich inline HTML",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "author": "jktrn",
  "keywords": [
    "knuth-plass",
    "line-breaking",
    "typography",
    "justification",
    "unicode",
    "browser"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "hyphen": "1.14.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/hyphen": "1.14.0",
    "publint": "0.3.21",
    "tsdown": "0.22.12",
    "typescript": "6.0.2",
    "unrun": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
