{
  "name": "@enscribe/linebreak",
  "version": "0.2.0",
  "description": "Knuth–Plass line breaking for the web",
  "keywords": [
    "knuth-plass",
    "line-breaking",
    "justification",
    "typography",
    "hyphenation",
    "text-layout",
    "typesetting",
    "tex"
  ],
  "type": "module",
  "license": "MIT",
  "author": "jktrn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktrn/enscribe.dev.git",
    "directory": "packages/linebreak"
  },
  "homepage": "https://github.com/jktrn/enscribe.dev/tree/main/packages/linebreak#readme",
  "bugs": {
    "url": "https://github.com/jktrn/enscribe.dev/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./attributes": {
      "types": "./dist/attributes.d.ts",
      "default": "./dist/attributes.js"
    },
    "./hyphenation": {
      "types": "./dist/hyphenation.d.ts",
      "default": "./dist/hyphenation.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.headless.json",
    "check": "bun run typecheck && bun run build",
    "gen:protrusion": "bun run tools/gen-protrusion.ts src/text/protrusion.ts && bunx biome format --write src/text/protrusion.ts",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "playground:preview": "vite preview --config playground/vite.config.ts",
    "playground:typecheck": "bun run playground/justif.ts && svelte-check --tsconfig playground/tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "hyphen": "1.14.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/hyphen": "1.14.0",
    "@zag-js/dialog": "1.43.0",
    "@zag-js/slider": "1.43.0",
    "@zag-js/svelte": "1.43.0",
    "@zag-js/toggle-group": "1.43.0",
    "@zag-js/tooltip": "1.43.0",
    "publint": "0.3.21",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "tsdown": "0.22.12",
    "typescript": "6.0.2",
    "vite": "8.2.0"
  }
}
