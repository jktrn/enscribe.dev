---
import { getEntries, type CollectionEntry } from "astro:content"
import { SITE } from "@/consts"
import { bannerOgImage, type BannerRaster } from "@/lib/assets/banner"
import { pageTitle } from "@/lib/content"
import { getImage } from "astro:assets"

type Props = {
  post: CollectionEntry<"blog">
  canonical?: string
  preloadBanner?: BannerRaster | null
}

const { post, canonical: canonicalPath, preloadBanner } = Astro.props
const { title, description, date, image } = post.data

const base = Astro.site ?? new URL(Astro.url.origin)
const authors = await getEntries(post.data.authors)
const authorNames = authors.map((author) => author.data.name)
const url = new URL(Astro.url.pathname, base)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base)
const card = image ?? bannerOgImage(post)
const ogImage = card
  ? new URL(card.src, base)
  : new URL(SITE.defaultPostImage, base)

const bannerPreloads = preloadBanner
  ? await Promise.all(
      (["light", "dark"] as const).map(async (scheme) => ({
        scheme,
        image: await getImage({
          src: preloadBanner[scheme],
          width: preloadBanner[scheme].width / 2,
          densities: [1, 2],
        }),
      })),
    )
  : []
---

<title>{pageTitle(title)}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

{bannerPreloads.map(({ scheme, image }) => (
    <link
      rel="preload"
      as="image"
      href={image.src}
      imagesrcset={image.srcSet.attribute}
      media={`(prefers-color-scheme: ${scheme})`}
      fetchpriority="high"
    />
  ))}

<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="article">
<meta property="og:url" content={url}>
<meta property="og:site_name" content={SITE.title}>
<meta property="og:locale" content={SITE.locale.replace("-", "_")}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={title}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={title}>
{authorNames.length > 0 && (
    <meta name="twitter:creator" content={authorNames.join(", ")} />
  )}

<meta property="article:published_time" content={date.toISOString()}>
{authorNames.map((name) => <meta property="article:author" content={name} />)}
