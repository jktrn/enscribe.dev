---
import type { BannerRaster } from "@/lib/assets/banner"
import { Image } from "astro:assets"

type Props = { raster: BannerRaster }

const { raster } = Astro.props
---

<Image
  src={raster.light}
  width={raster.light.width / 2}
  densities={[1, 2]}
  alt=""
  loading="lazy"
  data-theme-light
/>
<Image
  src={raster.dark}
  width={raster.dark.width / 2}
  densities={[1, 2]}
  alt=""
  loading="lazy"
  data-theme-dark
/>
