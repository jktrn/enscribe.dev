---
import { ClientRouter } from "astro:transitions"
import sansWoff2 from "@/assets/fonts/MDLorien-Regular.woff2?url"
import sansItalicWoff2 from "@/assets/fonts/MDLorien-Italic.woff2?url"
import sansScWoff2 from "@/assets/fonts/MDLorienSC-Regular.woff2?url"
import { SITE } from "@/consts"
---

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <meta name="color-scheme" content="light dark">

  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content={SITE.title}>
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  >

  <meta
    name="theme-color"
    content="#11100e"
    media="(prefers-color-scheme: dark)"
    data-scheme="dark"
  >
  <meta
    name="theme-color"
    content="#faf4ed"
    media="(prefers-color-scheme: light)"
    data-scheme="light"
  >

  <script is:inline>
    const THEME_COLORS = { light: "#faf4ed", dark: "#11100e" }

    const applyTheme = (doc, theme) => {
      const override = theme === "light" || theme === "dark" ? theme : null
      if (override) doc.documentElement.dataset.theme = override
      else delete doc.documentElement.dataset.theme
      doc.querySelector('meta[name="color-scheme"]').content =
        override ?? "light dark"
      for (const meta of doc.querySelectorAll('meta[name="theme-color"]')) {
        meta.content = THEME_COLORS[override ?? meta.dataset.scheme]
      }
    }

    const applyPreferences = (doc) => {
      const root = doc.documentElement
      root.dataset.js = ""
      let theme
      let textJustification
      let readerMode
      try {
        theme = localStorage.theme
        textJustification = localStorage.textJustification
        readerMode = localStorage.readerMode
      } catch {}
      applyTheme(doc, theme)
      root.dataset.textJustification =
        textJustification === "ragged" ? "ragged" : "justified"
      if (readerMode === "on") root.dataset.readerMode = ""
      else delete root.dataset.readerMode
    }
    applyPreferences(document)
    document.addEventListener("astro:before-swap", (event) => {
      applyPreferences(event.newDocument)
    })
  </script>

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="sitemap" href="/sitemap-index.xml">
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", Astro.site)}
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;600&display=swap"
  >

  <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin>
  <link
    rel="preload"
    href={sansItalicWoff2}
    as="font"
    type="font/woff2"
    crossorigin
  >
  <link
    rel="preload"
    href={sansScWoff2}
    as="font"
    type="font/woff2"
    crossorigin
  >
  <script is:inline>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    document.addEventListener(
      "load",
      (event) => {
        const img = event.target
        if (!(img instanceof HTMLImageElement) || img.loading !== "lazy") return
        if (!img.hasAttribute("data-loaded")) {
          img.setAttribute("data-loaded", "")
          if (!reducedMotion.matches) {
            img.animate(
              { opacity: [0, 1] },
              { duration: 900, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
            )
          }
        }
      },
      true,
    )
    document.addEventListener(
      "error",
      (event) => {
        const img = event.target
        if (img instanceof HTMLImageElement && img.loading === "lazy")
          img.setAttribute("data-loaded", "")
      },
      true,
    )
    document.addEventListener("astro:page-load", () => {
      for (const img of document.querySelectorAll('img[loading="lazy"]')) {
        if (img.complete && !img.hasAttribute("data-loaded")) {
          img.setAttribute("data-loaded", "")
        }
      }
    })
  </script>

  <ClientRouter />
  <slot />
</head>
