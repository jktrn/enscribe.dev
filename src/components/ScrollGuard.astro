<style is:global>
  html[data-page-scrolling] :is(.expressive-code pre, page-toc nav > ul) {
    pointer-events: none;
  }
</style>

<script>
  const SETTLE_MS = 200
  const root = document.documentElement
  const settle = () => root.removeAttribute("data-page-scrolling")

  let timer: ReturnType<typeof setTimeout> | undefined

  addEventListener(
    "scroll",
    () => {
      root.setAttribute("data-page-scrolling", "")
      if ("onscrollend" in window) return
      clearTimeout(timer)
      timer = setTimeout(settle, SETTLE_MS)
    },
    { passive: true },
  )
  addEventListener("scrollend", settle)
</script>
