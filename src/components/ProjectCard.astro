---
import ExternalIcon from "@/assets/icons/external.svg"
import FormattedDate from "@/components/FormattedDate.astro"
import ThemedBannerImage from "@/components/ThemedBannerImage.astro"
import { renderInline } from "@/lib/markdown/inline-markdown"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

type Props = { project: CollectionEntry<"projects"> }

const { project } = Astro.props
const { name, description, link, image, thumbnail, startDate, endDate } =
  project.data
const [nameHtml, descriptionHtml] = await Promise.all([
  renderInline(name),
  renderInline(description),
])
---

<li>
  {(thumbnail || image) && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
      >
        {thumbnail ? (
          <ThemedBannerImage raster={thumbnail} />
        ) : (
          image && <Image src={image} alt="" width={640} height={336} />
        )}
      </a>
    )}
  <entry-info data-typeset-root>
    <a href={link} target="_blank" rel="noopener noreferrer" data-linebreak-skip>
      <Fragment set:html={nameHtml} />
    </a>
    <entry-meta>
      {startDate && (
          <project-dates>
            <FormattedDate date={startDate} />
            {" → "}
            {endDate ? (
              <FormattedDate date={endDate} />
            ) : (
              "Present"
            )}
          </project-dates>
        )}
      <project-link>
        <ExternalIcon aria-hidden="true" />
        {new URL(link).hostname}
      </project-link>
    </entry-meta>
    <p><Fragment set:html={descriptionHtml} /></p>
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-inline-size: 0;

      > a {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        project-dates {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);
        }

        project-link {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);

          svg {
            inline-size: 1em;
            block-size: 1em;
          }
        }

        project-dates ~ project-link::before {
          content: "·";
          color: var(--muted-foreground);
        }
      }

      p {
        color: var(--muted-foreground);
      }
    }

    @media (width < 40rem) {
      flex-direction: column;
      align-items: stretch;

      > a {
        inline-size: 100%;
      }
    }
  }
</style>
