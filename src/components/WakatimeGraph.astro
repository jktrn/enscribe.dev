---
import type { SvgComponent } from "astro/types"
import AstroIcon from "@/assets/icons/languages/astro.svg"
import CIcon from "@/assets/icons/languages/c.svg"
import CppIcon from "@/assets/icons/languages/cpp.svg"
import CssIcon from "@/assets/icons/languages/css.svg"
import FigmaIcon from "@/assets/icons/languages/figma.svg"
import HtmlIcon from "@/assets/icons/languages/html.svg"
import JupyterIcon from "@/assets/icons/languages/jupyter-notebook.svg"
import MarkdownIcon from "@/assets/icons/languages/markdown.svg"
import PythonIcon from "@/assets/icons/languages/python.svg"
import SvelteIcon from "@/assets/icons/languages/svelte.svg"
import TexIcon from "@/assets/icons/languages/tex.svg"
import TypeScriptIcon from "@/assets/icons/languages/typescript.svg"
import YamlIcon from "@/assets/icons/languages/yaml.svg"
import data from "@/data/wakatime.json"

const ICONS: Record<string, SvgComponent> = {
  Astro: AstroIcon,
  C: CIcon,
  "C++": CppIcon,
  CSS: CssIcon,
  Figma: FigmaIcon,
  HTML: HtmlIcon,
  "Jupyter Notebook": JupyterIcon,
  Markdown: MarkdownIcon,
  Python: PythonIcon,
  Svelte: SvelteIcon,
  TeX: TexIcon,
  TypeScript: TypeScriptIcon,
  YAML: YamlIcon,
}

const MERGED: Record<string, string> = {
  JavaScript: "TypeScript",
  MDX: "Markdown",
  "Image (svg)": "Figma",
  SVG: "Figma",
}

const totals: Record<string, { human: number; agent: number }> = {}
for (const { name, human, agent } of data) {
  const total = (totals[MERGED[name] ?? name] ??= { human: 0, agent: 0 })
  total.human += human
  total.agent += agent
}

const rows = Object.entries(totals)
  .map(([name, { human, agent }]) => ({
    name,
    human,
    agent,
    total: human + agent,
  }))
  .sort((a, b) => b.total - a.total)
  .slice(0, 7)
const max = rows[0]?.total ?? 1
const width = (hours: number) => `width: ${(hours / max) * 70}%`
const fill = (index: number) =>
  `--fill: color-mix(in oklab, var(--from) ${100 - (index * 100) / 6}%, var(--to))`
const hours = (h: number) => `${Math.round(h)}h`
---

<wakatime-graph>
  {rows.map(({ name, human, agent, total }, index) => {
      const Icon = ICONS[name]
      return (
        <wakatime-row
          title={`${name}: ${hours(human)} by me, ${hours(agent)} by agents`}
          style={fill(index)}
        >
          <wakatime-icon>
            {Icon ? <Icon aria-hidden="true" /> : name[0]}
          </wakatime-icon>
          <wakatime-bar style={width(human)} />
          {agent >= 1 && <wakatime-bar data-agent style={width(agent)} />}
          <wakatime-hours>{hours(total)}</wakatime-hours>
        </wakatime-row>
      )
    })}
</wakatime-graph>

<style>
  wakatime-graph {
    --pad: clamp(1rem, 6cqw, 3.5rem);
    --gap: clamp(0.25rem, 2cqh, 1.25rem);
    --text: clamp(0.75rem, 5cqh, 2rem);
    --from: light-dark(var(--background-l3), var(--foreground-l2));
    --to: light-dark(var(--foreground-l6), var(--background-l5));

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--gap);
    height: 100%;
    padding: var(--pad);
  }

  wakatime-row {
    display: flex;
    align-items: center;
    gap: var(--gap);
    flex: 1;
    min-height: 0;
  }

  wakatime-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    aspect-ratio: 1;
    height: 100%;
    background-color: color-mix(in oklab, var(--border) 50%, transparent);
    color: light-dark(var(--foreground-l6), var(--foreground));
    font-size: var(--text);
    font-weight: var(--font-weight-medium);

    svg {
      width: 55%;
      height: 55%;
    }
  }

  wakatime-bar {
    height: 100%;
    background-color: var(--fill);
  }

  wakatime-bar[data-agent] {
    margin-inline-start: calc(2px - var(--gap));
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in oklab, var(--fill) 70%, transparent) 0 1px,
        transparent 1px 4px
      ),
      color-mix(in oklab, var(--fill) 45%, transparent);
  }

  wakatime-hours {
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
    font-size: var(--text);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
    white-space: nowrap;
  }

  @container (height < 20rem) {
    wakatime-row:nth-child(n + 7) {
      display: none;
    }
  }

  @container (height < 10rem) {
    wakatime-row:nth-child(n + 6) {
      display: none;
    }
  }

  @container (height < 8.5rem) {
    wakatime-row:nth-child(n + 5) {
      display: none;
    }
  }

  @container (height < 7rem) {
    wakatime-row:nth-child(n + 4) {
      display: none;
    }
  }
</style>
