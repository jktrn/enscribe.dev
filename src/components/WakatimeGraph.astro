  const svgIcon = (name: string): SVGSVGElement | null => {
    const d = ICON_PATHS[name.toLowerCase()]
    if (!d) return null
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg")
    svg.setAttribute("viewBox", "0 0 24 24")
    svg.setAttribute("aria-hidden", "true")
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path")
    path.setAttribute("fill", "currentColor")
    path.setAttribute("d", d)
    svg.appendChild(path)
    return svg
  }

  class WakatimeGraph extends HTMLElement {
    resizeObserver: ResizeObserver | null = null

    async connectedCallback() {
      this.resizeObserver = new ResizeObserver(() => this.updateVisibleRows())
      this.resizeObserver.observe(this)

      const cached = readTileCache<[string, number][]>("wakatime")
      if (cached) this.renderRows(cached)

      try {
        const response = await fetch(API_URL)
        if (!response.ok) throw new Error(response.statusText)
        const { data } = (await response.json()) as {
          data: { name: string; hours: number }[]
        }

        const totals = new Map<string, number>()
        for (const { name, hours } of data) {
          const normalized = NORMALIZED[name] ?? name
          totals.set(normalized, (totals.get(normalized) ?? 0) + hours)
        }

        const languages = [...totals.entries()]
          .sort((a, b) => b[1] - a[1])
          .slice(0, MAX_WAKATIME_ROWS)

        if (JSON.stringify(languages) === JSON.stringify(cached)) return
        writeTileCache("wakatime", languages)
        this.renderRows(languages)
      } catch {
        if (cached) return
        const error = document.createElement("wakatime-error")
        const title = document.createElement("p")
        title.textContent = "Error loading data"
        const hint = document.createElement("p")
        hint.textContent = "Please email me!"
        error.append(title, hint)
        this.replaceChildren(error)
      }
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect()
    }

    renderRows(languages: [string, number][]) {
      const max = languages[0]?.[1] ?? 1
      this.replaceChildren(
        ...languages.map(([name, hours], index) =>
          this.renderRow(name, hours, max, index),
        ),
      )
      this.updateVisibleRows()
    }

    updateVisibleRows() {
      const rootFontSize = Number.parseFloat(
        getComputedStyle(document.documentElement).fontSize,
      )
      const visibleRows = visibleWakatimeRows(this.clientHeight / rootFontSize)
      for (const [index, row] of this.querySelectorAll(
        "wakatime-row",
      ).entries()) {
        row.toggleAttribute("hidden", index >= visibleRows)
      }
    }

    renderRow(name: string, hours: number, max: number, index: number) {
      const row = document.createElement("wakatime-row")

      const icon = document.createElement("wakatime-icon")
      icon.title = name
      const svg = svgIcon(name)
      if (svg) icon.appendChild(svg)
      else icon.textContent = name.charAt(0).toUpperCase()

      const track = document.createElement("wakatime-track")
      const bar = document.createElement("wakatime-bar")
      bar.style.width = `${(hours / max) * 100 * 0.85}%`
      bar.style.setProperty("--wakatime-fill", `var(--wakatime-${index + 1})`)
      const label = document.createElement("wakatime-hours")
      label.textContent = `${Math.round(hours)}h`
      track.append(bar, label)

      row.append(icon, track)
      return row
    }
  }

  customElements.define("wakatime-graph", WakatimeGraph)
</script>
