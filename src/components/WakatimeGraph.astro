---
import { MAX_WAKATIME_ROWS } from "@/lib/wakatime"
---

<wakatime-graph>
  {Array.from({ length: MAX_WAKATIME_ROWS }).map((_, index) => (
      <wakatime-row data-skeleton>
        <wakatime-icon></wakatime-icon>
        <wakatime-track>
          <wakatime-bar style={`width: ${100 * 0.75 ** index}%`}
          ></wakatime-bar>
        </wakatime-track>
      </wakatime-row>
    ))}
</wakatime-graph>

<style is:global>
  wakatime-graph {
    --wakatime-pad: clamp(1rem, 6cqw, 3.5rem);
    --wakatime-gap: clamp(0.25rem, 2cqh, 1.25rem);
    --wakatime-text: clamp(0.75rem, 5cqh, 2rem);

    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--wakatime-gap);
    width: 100%;
    height: 100%;
    padding: var(--wakatime-pad);

    --wakatime-from: light-dark(var(--background-l3), var(--foreground-l2));
    --wakatime-to: light-dark(var(--foreground-l6), var(--background-l5));
    --wakatime-1: var(--wakatime-from);
    --wakatime-2: color-mix(
      in oklab,
      var(--wakatime-from) 83.333%,
      var(--wakatime-to)
    );
    --wakatime-3: color-mix(
      in oklab,
      var(--wakatime-from) 66.667%,
      var(--wakatime-to)
    );
    --wakatime-4: color-mix(
      in oklab,
      var(--wakatime-from) 50%,
      var(--wakatime-to)
    );
    --wakatime-5: color-mix(
      in oklab,
      var(--wakatime-from) 33.333%,
      var(--wakatime-to)
    );
    --wakatime-6: color-mix(
      in oklab,
      var(--wakatime-from) 16.667%,
      var(--wakatime-to)
    );
    --wakatime-7: var(--wakatime-to);

    wakatime-row {
      display: flex;
      align-items: stretch;
      gap: var(--wakatime-gap);
      flex: 1;
      min-height: 0;
    }

    wakatime-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      aspect-ratio: 1;
      height: 100%;
      background-color: color-mix(in oklab, var(--border) 50%, transparent);
      color: light-dark(var(--foreground-l6), var(--foreground));
      font-size: var(--wakatime-text);
      font-weight: var(--font-weight-medium);

      svg {
        width: 55%;
        height: 55%;
      }
    }

    wakatime-track {
      display: flex;
      align-items: center;
      gap: var(--wakatime-gap);
      flex: 1;
      min-width: 0;
      height: 100%;
    }

    wakatime-bar {
      display: block;
      height: 100%;
      background-color: var(--wakatime-fill, var(--primary));
    }

    wakatime-hours {
      flex-shrink: 0;
      color: color-mix(in oklab, var(--foreground) 80%, transparent);
      font-size: var(--wakatime-text);
      font-weight: var(--font-weight-medium);
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }

    wakatime-row[data-skeleton] {
      wakatime-icon,
      wakatime-bar {
        background-color: color-mix(in oklab, var(--muted) 60%, transparent);
        animation: wakatime-pulse 1.6s ease-in-out infinite;
      }
    }

    wakatime-error {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      text-align: center;

      p {
        margin: 0;
        font-size: var(--step--1);

        &:first-child {
          color: var(--destructive);
        }

        &:last-child {
          color: var(--muted-foreground);
        }
      }
    }
  }

  @keyframes wakatime-pulse {
    50% {
      opacity: 0.5;
    }
  }
</style>

