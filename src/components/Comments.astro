---
type Props = { term: string }

const { term } = Astro.props
---

<post-comments data-term={term}>
  <h2>Comments <span data-count></span></h2>
  <comment-list></comment-list>
  <a data-reply href="#" rel="noreferrer noopener">Reply on GitHub</a>
</post-comments>

<style>
  post-comments {
    display: block;
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: 2px solid var(--border);

    h2 {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);

      span {
        color: var(--muted-foreground);

        &:empty {
          display: none;
        }
      }
    }
  }

  comment-list {
    display: block;

    &:empty {
      display: none;
    }
  }

  a[data-reply] {
    display: inline-block;
    margin-block-start: var(--space-m);
    font-size: var(--step--1);
    color: var(--muted-foreground);

    &:hover {
      color: var(--foreground);
    }

    &[hidden] {
      display: none;
    }
  }

  comment-entry {
    display: block;
    margin-block-start: var(--space-m);

    comment-head {
      display: flex;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-end: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      img {
        inline-size: 18px;
        block-size: 18px;
        border-radius: var(--radius-full);
      }

      a {
        color: var(--foreground);
      }

      time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
        color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
      }
    }
  }

  comment-replies {
    display: block;
    margin-inline-start: var(--space-s);
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--border);
  }
</style>

<script>
  import { formatDate } from "@/lib/utils"

  type Author = { login: string; url: string; avatarUrl: string }
  type Comment = {
    id: string
    url: string
    createdAt: string
    bodyHTML: string
    author: Author | null
    replies: Comment[]
  }
  type Discussion = { url: string | null; total: number; comments: Comment[] }

  const REPO = "https://github.com/jktrn/enscribe.dev/discussions"

  const el = (tag: string) => document.createElement(tag)

  const renderComment = (comment: Comment) => {
    const entry = el("comment-entry")
    const head = el("comment-head")

    if (comment.author) {
      const avatar = document.createElement("img")
      avatar.src = comment.author.avatarUrl
      avatar.alt = ""
      avatar.width = 18
      avatar.height = 18
      const name = document.createElement("a")
      name.href = comment.author.url
      name.textContent = comment.author.login
      head.append(avatar, name)
    }

    const time = document.createElement("time")
    time.dateTime = comment.createdAt
    time.textContent = formatDate(new Date(comment.createdAt))
    head.append(time)

    const body = el("prose-content")
    body.innerHTML = comment.bodyHTML

    entry.append(head, body)

    if (comment.replies.length > 0) {
      const replies = el("comment-replies")
      for (const reply of comment.replies) replies.append(renderComment(reply))
      entry.append(replies)
    }

    return entry
  }

  const setup = async () => {
    const root = document.querySelector<HTMLElement>("post-comments")
    if (!root) return

    const { term } = root.dataset
    const list = root.querySelector<HTMLElement>("comment-list")
    const count = root.querySelector<HTMLElement>("[data-count]")
    const reply = root.querySelector<HTMLAnchorElement>("[data-reply]")
    if (!term || !list || !count || !reply) return

    reply.hidden = true

    const response = await fetch(
      `/api/comments?term=${encodeURIComponent(term)}`,
    )
    if (!response.ok) return

    const discussion = (await response.json()) as Discussion
    list.replaceChildren(...discussion.comments.map(renderComment))
    count.textContent = discussion.total > 0 ? `(${discussion.total})` : ""
    reply.href = discussion.url ?? REPO
    reply.textContent =
      discussion.total > 0
        ? "Reply on GitHub"
        : "Start the discussion on GitHub"
    reply.hidden = false
  }

  document.addEventListener("astro:page-load", setup)
</script>
