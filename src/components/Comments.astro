---
import { readFileSync } from "node:fs"
import { createHash } from "node:crypto"
import { resolve } from "node:path"

type Props = { term: string }

const { term } = Astro.props

const read = (name: string) =>
  readFileSync(resolve("public", "giscus", `${name}.css`), "utf8")

const baseTheme = read("base")
const lightTheme = read("light")
const darkTheme = read("dark")

const inline = (variant: string) => {
  const css = baseTheme + variant.replace(/@import[^;]+;/, "")
  return `data:text/css;base64,${Buffer.from(css).toString("base64")}`
}

const themeVersion = createHash("sha256")
  .update(baseTheme)
  .update(lightTheme)
  .update(darkTheme)
  .digest("hex")
  .slice(0, 12)

const theme = import.meta.env.DEV
  ? { light: inline(lightTheme), dark: inline(darkTheme) }
  : { light: undefined, dark: undefined }
---

<post-comments id="comments">
  <h2>Comments <span data-count></span></h2>
  <giscus-thread
    data-term={term}
    data-theme-light={theme.light}
    data-theme-dark={theme.dark}
    data-theme-version={themeVersion}
  ></giscus-thread>
</post-comments>

<style>
  post-comments {
    display: block;
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: 2px solid var(--border);

    h2 {
      margin-block-end: var(--space-s);
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);

      span {
        color: var(--muted-foreground);

        &:empty {
          display: none;
        }
      }
    }

    giscus-thread {
      display: block;
    }

    :global(.giscus-frame) {
      inline-size: 100%;
      border: none;
      border-radius: 0;

      &:focus-visible {
        outline: none;
      }
    }
  }
</style>

<script>
  const ORIGIN = "https://giscus.app"
  const SESSION_KEY = "giscus-session"
  const THEME_PREFIX = "data:text/css;base64,"
  const root = document.documentElement

  let teardown: (() => void) | undefined

  const readSession = () => {
    try {
      return localStorage.getItem(SESSION_KEY)
    } catch {
      return null
    }
  }

  const saveSession = (session: string) => {
    try {
      localStorage.setItem(SESSION_KEY, JSON.stringify(session))
    } catch {}
  }

  const clearSession = () => {
    try {
      localStorage.removeItem(SESSION_KEY)
    } catch {}
  }

  const setup = () => {
    teardown?.()
    teardown = undefined

    const mount = document.querySelector<HTMLElement>("giscus-thread")
    if (!mount || mount.childElementCount > 0) return
    const comments = mount.closest<HTMLElement>("post-comments")
    if (!comments) return

    const { term, themeLight, themeDark, themeVersion } = mount.dataset
    const controller = new AbortController()
    const { signal } = controller

    const themeUrl = (
      name: "light" | "dark",
      inlineTheme: string | undefined,
    ) => {
      if (!inlineTheme?.startsWith(THEME_PREFIX)) {
        return `${location.origin}/giscus/${name}.css?v=${themeVersion}`
      }

      const css = atob(inlineTheme.slice(THEME_PREFIX.length)).replaceAll(
        "https://enscribe.dev/",
        `${location.origin}/`,
      )
      return `${THEME_PREFIX}${btoa(css)}`
    }
    const themes = {
      light: themeUrl("light", themeLight),
      dark: themeUrl("dark", themeDark),
    }

    const currentTheme = () =>
      themes[
        root.dataset.theme === "dark" ||
        (!root.dataset.theme &&
          matchMedia("(prefers-color-scheme: dark)").matches)
          ? "dark"
          : "light"
      ]

    const url = new URL(location.href)
    let session = url.searchParams.get("giscus") ?? ""
    const savedSession = readSession()
    url.searchParams.delete("giscus")
    url.hash = ""
    const cleanedLocation = url.toString()
    url.hash = comments.id
    const authOrigin = url.toString()

    if (session) {
      saveSession(session)
      history.replaceState(history.state, document.title, cleanedLocation)
    } else if (savedSession) {
      try {
        const parsedSession: unknown = JSON.parse(savedSession)
        if (typeof parsedSession === "string") session = parsedSession
        else clearSession()
      } catch {
        clearSession()
      }
    }

    const description =
      document.querySelector<HTMLMetaElement>("meta[property='og:description']")
        ?.content ??
      document.querySelector<HTMLMetaElement>("meta[name='description']")
        ?.content ??
      ""
    const params = new URLSearchParams({
      origin: authOrigin,
      session,
      theme: currentTheme(),
      reactionsEnabled: "0",
      emitMetadata: "1",
      inputPosition: "top",
      repo: "jktrn/enscribe.dev",
      repoId: "R_kgDOKS3cog",
      category: "Comments",
      categoryId: "DIC_kwDOKS3cos4DECaf",
      strict: "1",
      description,
      backLink: cleanedLocation,
      term: term ?? "",
    })

    const frame = document.createElement("iframe")
    Object.assign(frame, {
      className: "giscus-frame giscus-frame--loading",
      title: "Comments",
      scrolling: "no",
      loading: "lazy",
      src: `${ORIGIN}/en/widget?${params}`,
    })
    frame.allow = "clipboard-write"
    frame.style.opacity = "0"
    mount.append(frame)

    const syncTheme = () => {
      frame.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: currentTheme() } } },
        ORIGIN,
      )
    }

    frame.addEventListener(
      "load",
      () => {
        frame.style.removeProperty("opacity")
        frame.classList.remove("giscus-frame--loading")
        syncTheme()
      },
      { signal },
    )

    const signOut = () => {
      clearSession()
      params.delete("session")
      frame.src = `${ORIGIN}/en/widget?${params}`
    }

    const observer = new MutationObserver(syncTheme)
    teardown = () => {
      controller.abort()
      observer.disconnect()
    }

    observer.observe(root, { attributeFilter: ["data-theme"] })
    matchMedia("(prefers-color-scheme: dark)").addEventListener(
      "change",
      syncTheme,
      { signal },
    )

    addEventListener(
      "message",
      (event: MessageEvent) => {
        if (event.origin !== ORIGIN || event.source !== frame.contentWindow)
          return
        const data = event.data?.giscus
        if (!data) return

        if (data.resizeHeight) frame.style.height = `${data.resizeHeight}px`

        if (data.signOut) {
          signOut()
          return
        }

        if (typeof data.error === "string") {
          const sessionExpired = [
            "Bad credentials",
            "Invalid state value",
            "State has expired",
          ].some((message) => data.error.includes(message))

          if (sessionExpired && params.get("session")) {
            signOut()
          } else {
            console.warn(`[giscus] ${data.error}`)
          }
          return
        }

        const total = data.discussion?.totalCommentCount
        if (typeof total !== "number") return
        const label = comments.querySelector<HTMLElement>("[data-count]")
        if (label) label.textContent = total > 0 ? `(${total})` : ""
      },
      { signal },
    )
  }

  document.addEventListener("astro:page-load", setup)
</script>
