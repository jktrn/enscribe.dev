---
import { readFileSync } from "node:fs"

type Props = { term: string }

const { term } = Astro.props

const read = (name: string) =>
  readFileSync(
    new URL(`../../public/giscus/${name}.css`, import.meta.url),
    "utf8",
  )

const inline = (name: string) => {
  const css = read("base") + read(name).replace(/@import[^;]+;/, "")
  return `data:text/css;base64,${Buffer.from(css).toString("base64")}`
}

const theme = import.meta.env.DEV
  ? { light: inline("light"), dark: inline("dark") }
  : { light: undefined, dark: undefined }
---

<post-comments>
  <h2>Comments</h2>
  <div
    class="giscus"
    data-term={term}
    data-theme-light={theme.light}
    data-theme-dark={theme.dark}
  ></div>
</post-comments>

<style>
  post-comments {
    display: block;
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: 2px solid var(--border);

    h2 {
      margin-block-end: var(--space-s);
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
    }

    :global(.giscus-frame) {
      inline-size: 100%;
      border: none;
    }
  }
</style>

<script>
  const ORIGIN = "https://giscus.app"
  const root = document.documentElement

  let teardown: (() => void) | undefined

  const setup = () => {
    teardown?.()
    teardown = undefined

    const mount = document.querySelector<HTMLElement>(".giscus")
    if (!mount || mount.childElementCount > 0) return

    const { term, themeLight, themeDark } = mount.dataset

    const themeUrl = (name: "light" | "dark") =>
      (name === "dark" ? themeDark : themeLight) ??
      `${location.origin}/giscus/${name}.css`

    const currentTheme = () =>
      themeUrl(
        root.dataset.theme === "dark" ||
          (!root.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches)
          ? "dark"
          : "light",
      )

    const script = document.createElement("script")
    script.src = `${ORIGIN}/client.js`
    script.crossOrigin = "anonymous"
    script.async = true
    Object.assign(script.dataset, {
      repo: "jktrn/enscribe.dev",
      repoId: "R_kgDOKS3cog",
      category: "Comments",
      categoryId: "DIC_kwDOKS3cos4DECaf",
      mapping: "specific",
      term,
      strict: "1",
      reactionsEnabled: "0",
      emitMetadata: "0",
      inputPosition: "top",
      theme: currentTheme(),
      lang: "en",
      loading: "lazy",
    })
    mount.append(script)

    const syncTheme = () => {
      const frame = document.querySelector<HTMLIFrameElement>(".giscus-frame")
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: currentTheme() } } },
        ORIGIN,
      )
    }

    const controller = new AbortController()
    const observer = new MutationObserver(syncTheme)
    teardown = () => {
      controller.abort()
      observer.disconnect()
    }

    observer.observe(root, { attributeFilter: ["data-theme"] })
    matchMedia("(prefers-color-scheme: dark)").addEventListener(
      "change",
      syncTheme,
      { signal: controller.signal },
    )
  }

  document.addEventListener("astro:page-load", setup)
</script>
