---
---

<sidenote-layer
  aria-hidden="true"
  data-linebreak-root
  data-linebreak-narrow
></sidenote-layer>

<script>
  import { onReaderModeChange } from "@/lib/typography/preference-events"
  import { rescanProse } from "@/lib/typography/prose-justification"
  import { hashId } from "@/lib/utils"

  type Sidenote = {
    scope: Element
    id: string
    el: HTMLElement
    ref: HTMLElement | null
  }

  const resolve = ({ scope, id, ref }: Sidenote) =>
    ref?.isConnected
      ? ref
      : scope.querySelector<HTMLElement>(`[id="${CSS.escape(id)}"]`)

  const build = (layer: HTMLElement) => {
    const notes: Sidenote[] = []
    const lists = document.querySelectorAll<HTMLElement>(
      "prose-content .footnotes",
    )

    for (const list of lists) {
      const scope = list.closest("prose-content")
      if (!scope) continue

      for (const ref of scope.querySelectorAll<HTMLElement>(
        "[data-footnote-ref]",
      )) {
        if (ref.closest(".footnotes") || !ref.id) continue
        const source = list.querySelector(
          `li[id="${CSS.escape(hashId((ref as HTMLAnchorElement).hash))}"]`,
        )
        if (!source) continue

        const marker = document.createElement("sidenote-marker")
        marker.textContent = ref.textContent
        const body = document.createElement("sidenote-body")
        body.append(...source.cloneNode(true).childNodes)
        body.querySelector("[data-footnote-backref]")?.remove()
        for (const node of body.querySelectorAll("[id]")) {
          node.removeAttribute("id")
        }
        for (const link of body.querySelectorAll("a[href]")) {
          link.setAttribute("tabindex", "-1")
        }

        const el = document.createElement("sidenote")
        el.setAttribute("for", ref.id)
        el.append(marker, body)
        layer.append(el)
        notes.push({ scope, id: ref.id, el, ref })
      }
    }

    return { notes, lists }
  }

  const pairing = (notes: Sidenote[]) => {
    const style = document.createElement("style")
    style.setAttribute("data-linebreak-skip", "")
    const ids = notes.map(({ id }) => id).filter((id) => /^[\w-]+$/.test(id))
    if (ids.length === 0) return style

    const lit = ids.map(
      (id) =>
        `body:has([id="${id}"]:is(:hover, :focus-visible), sidenote[for="${id}"]:is([expanded], :hover)) :is(sidenote[for="${id}"], [id="${id}"])`,
    )
    const pinned = ids.map(
      (id) =>
        `body:has(sidenote[for="${id}"][expanded]) :is(sidenote[for="${id}"]:not([expanded]), [id="${id}"])`,
    )
    style.textContent = [
      `${lit.join(",")}{--lit: var(--foreground); --lit-fill: var(--background-l3);}`,
      `${pinned.join(",")}{--lit: var(--primary-foreground); --lit-fill: var(--primary);}`,
    ].join("")
    return style
  }

  let teardown: (() => void) | undefined

  const setup = () => {
    teardown?.()
    teardown = undefined

    const layer = document.querySelector<HTMLElement>("page-toc sidenote-layer")
    if (!layer) return
    layer.replaceChildren()

    const { notes, lists } = build(layer)
    const first = notes[0]
    if (!first) return
    layer.append(pairing(notes))

    const root = document.documentElement
    const controller = new AbortController()
    const { signal } = controller
    const wide = matchMedia("screen and (min-width: 64rem)")

    let frame: number | undefined
    let active = false
    let pad = 0
    let lead = 0
    let step = 0
    let expanded: Sidenote | undefined

    const layout = () => {
      frame = undefined
      if (!active) return

      const rail = layer.getBoundingClientRect()
      if (rail.height === 0) return

      const boxes = notes.map((note) => resolve(note)?.getBoundingClientRect())
      const heights = notes.map((note) => note.el.offsetHeight)

      const wanted = boxes.map((box) => box && box.top - rail.top - pad)

      const spread: (number | undefined)[] = []
      let prev: number | undefined
      for (const top of wanted) {
        if (top === undefined) {
          spread.push(undefined)
          continue
        }
        const kept =
          prev === undefined || top - prev >= lead ? top : prev + step
        spread.push(kept)
        prev = kept
      }

      let last = -1
      let shift = 0
      if (expanded) {
        const i = notes.indexOf(expanded)
        const top = spread[i]
        if (top !== undefined) {
          last = i
          const next = spread.slice(i + 1).find((w) => w !== undefined)
          if (next !== undefined) {
            shift = Math.max(0, top + heights[i]! - next)
          }
        }
      }

      const tops = spread.map((top, i) =>
        top === undefined ? undefined : i > last ? top + shift : top,
      )

      const below: (number | undefined)[] = new Array(notes.length)
      let seen: number | undefined
      for (let i = notes.length - 1; i >= 0; i--) {
        below[i] = seen
        if (tops[i] !== undefined) seen = tops[i]
      }

      let lost = false
      for (const [i, note] of notes.entries()) {
        const top = tops[i]
        const height = heights[i]!
        if (top === undefined) {
          note.el.removeAttribute("visible")
          if (note === expanded) lost = true
          continue
        }
        const on = top + height > 0 && top < rail.height
        note.el.toggleAttribute("visible", on)
        if (note === expanded && !on) lost = true
        if (!on) continue

        note.el.style.translate = `0 ${Math.round(top)}px`
        const next = below[i]
        const room = next === undefined ? height : next - top
        const clipped = room < height
        note.el.toggleAttribute("clipped", clipped)
        if (clipped) {
          note.el.style.setProperty("--clip", `${Math.round(height - room)}px`)
        } else {
          note.el.style.removeProperty("--clip")
        }
      }

      if (lost) collapse()
    }

    let motion: ReturnType<typeof setTimeout> | undefined

    const settle = () => {
      if (motion !== undefined) clearTimeout(motion)
      motion = undefined
      layer.removeAttribute("animating")
    }

    const animate = () => {
      layer.setAttribute("animating", "")
      if (motion !== undefined) clearTimeout(motion)
      motion = setTimeout(settle, 320)
    }

    const collapse = (animated = false) => {
      if (animated) animate()
      else settle()
      if (!expanded) return
      expanded.el.removeAttribute("expanded")
      expanded = undefined
      schedule()
    }

    const schedule = () => {
      if (frame === undefined) frame = requestAnimationFrame(layout)
    }

    const apply = () => {
      const on = wide.matches && root.dataset.readerMode === undefined
      if (on === active) return
      active = on
      root.toggleAttribute("data-sidenotes", on)
      for (const list of lists) {
        list.toggleAttribute("data-collapsed", on)
        list.toggleAttribute("data-linebreak-skip", on)
      }
      if (on) return schedule()
      for (const note of notes) note.el.removeAttribute("visible")
    }

    const claimed = new Set(notes.map(({ id }) => id))
    document.addEventListener(
      "click",
      (event) => {
        if (!active) return
        const target = event.target as Element | null
        const ref = target?.closest?.("[data-footnote-ref]")
        const el = target?.closest?.("sidenote")

        let note: Sidenote | undefined
        if (ref && claimed.has(ref.id)) {
          event.preventDefault()
          note = notes.find(({ id }) => id === ref.id)
        } else if (el) {
          if (target?.closest?.("a[href]")) return
          if (getSelection()?.isCollapsed === false) return
          note = notes.find(({ el: own }) => own === el)
        } else return

        if (!note) return
        if (note === expanded) return collapse(true)

        expanded?.el.removeAttribute("expanded")
        expanded = note
        note.el.setAttribute("expanded", "")
        animate()
        schedule()
      },
      { signal, capture: true },
    )

    const railResize = new ResizeObserver(() => {
      const style = getComputedStyle(first.el)
      pad = Number.parseFloat(style.paddingBlockStart) || 0
      lead = Number.parseFloat(style.lineHeight) || 0
      step = pad + 2 * lead
      schedule()
    })
    railResize.observe(layer)

    const noteResize = new ResizeObserver(schedule)
    for (const note of notes) noteResize.observe(note.el)

    teardown = () => {
      controller.abort()
      if (motion !== undefined) clearTimeout(motion)
      railResize.disconnect()
      noteResize.disconnect()
      if (frame !== undefined) cancelAnimationFrame(frame)
      root.removeAttribute("data-sidenotes")
      for (const list of lists) {
        list.removeAttribute("data-collapsed")
        list.removeAttribute("data-linebreak-skip")
      }
    }

    addEventListener(
      "scroll",
      () => {
        settle()
        schedule()
      },
      { passive: true, signal },
    )
    wide.addEventListener("change", apply, { signal })
    onReaderModeChange(apply, signal)

    apply()
    rescanProse()
  }

  document.addEventListener("astro:page-load", setup)
</script>
