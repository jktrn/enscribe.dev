---
import { CITIES, DEFAULT_CITY_ID, cityIndexForPlace } from "@/lib/food-cities"
import data from "@/data/beli-places.json"

const points = data.places
  .filter((place) => place.latitude !== null && place.longitude !== null)
  .map((place) => [
    Number(place.longitude.toFixed(5)),
    Number(place.latitude.toFixed(5)),
    cityIndexForPlace(place.id, place.latitude, place.longitude),
    place.score ?? -1,
  ])
  .filter((point) => point[2] >= 0)

const payload = JSON.stringify(points).replaceAll("<", "\\u003c")
---

<div class="food-map" data-food-map>
  <div class="food-map-visual">
    <div class="food-map-canvas" data-food-map-canvas></div>
    <canvas class="food-map-places" data-food-map-places></canvas>
    <canvas class="food-map-transition" data-food-map-transition></canvas>

    <label class="food-map-city">
      <span class="sr-only">Show places in</span>
      <select data-food-map-city>
        {CITIES.map((city) => (
            <option value={city.id} selected={city.id === DEFAULT_CITY_ID}>
              {city.label}
            </option>
          ))}
      </select>
    </label>
  </div>

  <script
    is:inline
    type="application/json"
    data-food-map-data
    set:html={payload}
  />
</div>

<script>
  import { CITIES, DEFAULT_CITY_ID, cityById } from "@/lib/food-cities"
  import { createColorResolver, TILE_ZOOM_RANGE } from "@/lib/map-style"

  type Row = [number, number, number, number]

  const STORAGE_KEY = "food-map-city"

  const cityIndex = (id: string) => CITIES.findIndex((city) => city.id === id)

  let teardown: (() => void) | undefined

  const mount = async (root: HTMLElement) => {
    const canvas = root.querySelector<HTMLElement>("[data-food-map-canvas]")
    const placesCanvas = root.querySelector<HTMLCanvasElement>(
      "[data-food-map-places]",
    )
    const transitionCanvas = root.querySelector<HTMLCanvasElement>(
      "[data-food-map-transition]",
    )
    const dataNode = root.querySelector<HTMLElement>("[data-food-map-data]")
    if (!canvas || !placesCanvas || !transitionCanvas || !dataNode?.textContent)
      return

    const rows = JSON.parse(dataNode.textContent) as Row[]
    const rowsByCity = CITIES.map((_, index) =>
      rows.filter((row) => row[2] === index).sort((a, b) => a[3] - b[3]),
    )

    const maplibrePromise = import("maplibre-gl")
    const [workerUrl, mapStyleModule] = await Promise.all([
      import("maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url").then(
        (module) => module.default,
      ),
      import("@/lib/map-style"),
    ])
    const {
      applyMapTheme,
      collapseDuplicateWaterLabels,
      bubbleColorsForScore,
      loadMapStyle,
      TILE_LAYER_IDS,
    } = mapStyleModule
    const { Map: MapLibreMap, setWorkerUrl } = await maplibrePromise

    setWorkerUrl(workerUrl)

    let storedCity: string | null = null
    try {
      storedCity = sessionStorage.getItem(STORAGE_KEY)
    } catch {}
    const startCity = cityById(storedCity) ?? cityById(DEFAULT_CITY_ID)!

    const color = createColorResolver()
    const map = new MapLibreMap({
      container: canvas,
      style: await loadMapStyle({
        keepLayerIds: TILE_LAYER_IDS,
        instantTransitions: true,
      }),
      center: [...startCity.center],
      zoom: startCity.zoom,
      minZoom: TILE_ZOOM_RANGE.min,
      maxZoom: TILE_ZOOM_RANGE.max,
      interactive: false,
      attributionControl: false,
      pixelRatio: window.devicePixelRatio,
      canvasContextAttributes: {
        antialias: true,
        powerPreference: "low-power",
        preserveDrawingBuffer: true,
      },
      fadeDuration: 0,
      refreshExpiredTiles: false,
      crossSourceCollisions: false,
      renderWorldCopies: false,
      maxTileCacheZoomLevels: 12,
      validateStyle: import.meta.env.DEV,
    })

    const DOT_RADIUS = 8.5
    const RING_WIDTH = 1.25
    const LABEL_SIZE = 8
    const renderScale = () =>
      Math.min(Math.max(Math.ceil(window.devicePixelRatio * 2), 2), 4)

    const scoreLabel = (score: number) =>
      score < 0 ? "\u2014" : score.toFixed(1)

    const dotCanvas = (score: number, scale: number) => {
      const { fill, ink, ring } = bubbleColorsForScore(
        score < 0 ? null : score,
        color.resolve,
      )
      const box = Math.ceil((DOT_RADIUS + RING_WIDTH) * 2)
      const canvas = document.createElement("canvas")
      canvas.width = canvas.height = box * scale
      const ctx = canvas.getContext("2d")
      if (!ctx) return null
      ctx.scale(scale, scale)
      const mid = box / 2
      ctx.beginPath()
      ctx.arc(mid, mid, DOT_RADIUS, 0, Math.PI * 2)
      ctx.fillStyle = fill
      ctx.fill()
      ctx.lineWidth = RING_WIDTH
      ctx.strokeStyle = ring
      ctx.stroke()
      ctx.fillStyle = ink
      ctx.font = `${LABEL_SIZE}px "MD Lorien", sans-serif`
      ctx.textAlign = "center"
      ctx.textBaseline = "middle"
      ctx.fillText(scoreLabel(score), mid, mid + 0.5)
      return canvas
    }

    const scores = [...new Set(rows.map((row) => row[3]))]
    const dotCanvases = new Map<number, HTMLCanvasElement>()
    let activeCityIndex = cityIndex(startCity.id)
    const syncDotCanvases = () => {
      dotCanvases.clear()
      const scale = renderScale()
      for (const score of scores) {
        const image = dotCanvas(score, scale)
        if (image) dotCanvases.set(score, image)
      }
    }
    const drawPlaces = () => {
      const context = placesCanvas.getContext("2d")
      if (!context) return
      const scale = renderScale()
      const width = placesCanvas.clientWidth
      const height = placesCanvas.clientHeight
      const pixelWidth = Math.round(width * scale)
      const pixelHeight = Math.round(height * scale)
      if (
        placesCanvas.width !== pixelWidth ||
        placesCanvas.height !== pixelHeight
      ) {
        placesCanvas.width = pixelWidth
        placesCanvas.height = pixelHeight
      }
      context.setTransform(scale, 0, 0, scale, 0, 0)
      context.clearRect(0, 0, width, height)

      const imageScaleFactor = renderScale()
      const box = Math.ceil((DOT_RADIUS + RING_WIDTH) * 2)
      for (const [lon, lat, , score] of rowsByCity[activeCityIndex] ?? []) {
        const point = map.project([lon, lat])
        if (point.x < 0 || point.x > width || point.y < 0 || point.y > height) {
          continue
        }
        const image = dotCanvases.get(score)
        if (!image) continue
        context.drawImage(
          image,
          point.x - box / 2,
          point.y - box / 2,
          image.width / imageScaleFactor,
          image.height / imageScaleFactor,
        )
      }
    }
    syncDotCanvases()

    let densityQuery: MediaQueryList | undefined
    const syncPixelRatio = () => {
      map.setPixelRatio(renderScale())
      syncDotCanvases()
      drawPlaces()
      densityQuery?.removeEventListener("change", syncPixelRatio)
      densityQuery = matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`)
      densityQuery.addEventListener("change", syncPixelRatio)
    }
    syncPixelRatio()

    const theme = () => {
      applyMapTheme(map, color.resolve)
      syncDotCanvases()
      drawPlaces()
    }

    map.on("style.load", () => {
      collapseDuplicateWaterLabels(map)
      applyMapTheme(map, color.resolve)
    })

    let disposed = false
    let revealFrame: number | undefined
    let revealTimer: number | undefined
    let revealed = false
    const reveal = () => {
      if (revealed || disposed) return
      revealed = true
      drawPlaces()
      revealFrame = requestAnimationFrame(() => {
        if (disposed) return
        revealFrame = requestAnimationFrame(() => {
          if (!disposed) root.dataset.ready = "true"
        })
      })
    }

    revealTimer = window.setTimeout(reveal, 2000)
    map.on("load", drawPlaces)
    map.once("idle", reveal)
    map.on("render", drawPlaces)

    const select = root.querySelector<HTMLSelectElement>("[data-food-map-city]")
    if (select) select.value = startCity.id
    let cityTransitionFrame: number | undefined
    let cityTransitionTimer: number | undefined
    let cityTransitionToken = 0
    let cityIdleListener: (() => void) | undefined
    const captureCurrentCity = () => {
      if (Number(getComputedStyle(transitionCanvas).opacity) > 0) {
        transitionCanvas.dataset.active = "true"
        return true
      }
      const context = transitionCanvas.getContext("2d")
      if (!context) return false
      const scale = renderScale()
      const width = transitionCanvas.clientWidth
      const height = transitionCanvas.clientHeight
      transitionCanvas.width = Math.round(width * scale)
      transitionCanvas.height = Math.round(height * scale)
      context.setTransform(scale, 0, 0, scale, 0, 0)
      context.fillStyle = getComputedStyle(root).backgroundColor
      context.fillRect(0, 0, width, height)

      const mapCanvas = map.getCanvas()
      context.globalAlpha = 0.85
      context.drawImage(
        mapCanvas,
        0,
        0,
        mapCanvas.width,
        mapCanvas.height,
        0,
        0,
        width,
        height,
      )
      context.globalAlpha = 1
      context.drawImage(
        placesCanvas,
        0,
        0,
        placesCanvas.width,
        placesCanvas.height,
        0,
        0,
        width,
        height,
      )
      transitionCanvas.dataset.active = "true"
      return true
    }
    const finishCityTransition = (token: number) => {
      if (token !== cityTransitionToken || disposed) return
      if (cityTransitionTimer !== undefined) clearTimeout(cityTransitionTimer)
      if (cityIdleListener) map.off("idle", cityIdleListener)
      cityIdleListener = undefined
      cityTransitionFrame = requestAnimationFrame(() => {
        if (token !== cityTransitionToken || disposed) return
        cityTransitionFrame = requestAnimationFrame(() => {
          if (token === cityTransitionToken && !disposed) {
            transitionCanvas.dataset.active = "false"
          }
        })
      })
    }
    const showCity = () => {
      const city = cityById(select?.value)
      if (!city) return
      const nextCityIndex = cityIndex(city.id)
      if (nextCityIndex === activeCityIndex) return

      const token = ++cityTransitionToken
      if (cityTransitionFrame !== undefined) {
        cancelAnimationFrame(cityTransitionFrame)
      }
      if (cityTransitionTimer !== undefined) clearTimeout(cityTransitionTimer)
      if (cityIdleListener) map.off("idle", cityIdleListener)
      captureCurrentCity()
      cityTransitionFrame = requestAnimationFrame(() => {
        if (token !== cityTransitionToken || disposed) return
        activeCityIndex = nextCityIndex
        cityIdleListener = () => finishCityTransition(token)
        map.once("idle", cityIdleListener)
        map.jumpTo({ center: [...city.center], zoom: city.zoom })
        drawPlaces()
        cityTransitionTimer = window.setTimeout(
          () => finishCityTransition(token),
          2000,
        )
      })
      try {
        sessionStorage.setItem(STORAGE_KEY, city.id)
      } catch {}
    }
    select?.addEventListener("change", showCity)

    const scheme = matchMedia("(prefers-color-scheme: dark)")
    scheme.addEventListener("change", theme)
    const observer = new MutationObserver(theme)
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    })

    teardown = () => {
      disposed = true
      if (revealFrame !== undefined) cancelAnimationFrame(revealFrame)
      if (revealTimer !== undefined) clearTimeout(revealTimer)
      if (cityTransitionFrame !== undefined) {
        cancelAnimationFrame(cityTransitionFrame)
      }
      if (cityTransitionTimer !== undefined) clearTimeout(cityTransitionTimer)
      if (cityIdleListener) map.off("idle", cityIdleListener)
      densityQuery?.removeEventListener("change", syncPixelRatio)
      select?.removeEventListener("change", showCity)
      scheme.removeEventListener("change", theme)
      observer.disconnect()
      color.dispose()
      map.remove()
      delete root.dataset.ready
    }
  }

  const setup = () => {
    teardown?.()
    teardown = undefined
    const root = document.querySelector<HTMLElement>("[data-food-map]")
    if (!root) return

    if (!("IntersectionObserver" in window)) {
      void mount(root)
      return
    }

    const watcher = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        watcher.disconnect()
        void mount(root)
      },
      { rootMargin: "200px" },
    )
    watcher.observe(root)
  }

  document.addEventListener("astro:page-load", setup)
  document.addEventListener("astro:before-swap", () => {
    teardown?.()
    teardown = undefined
  })
</script>

<style>
  .food-map {
    position: absolute;
    inset: 0;
    background: var(--background-l0);
  }

  .food-map-visual {
    position: absolute;
    inset: 0;
    isolation: isolate;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .food-map[data-ready="true"] .food-map-visual {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .food-map-canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0.85;
  }

  .food-map-places {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .food-map-transition {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .food-map-transition[data-active="true"] {
    opacity: 1;
    transition: none;
  }

  :global(.food-map .maplibregl-canvas) {
    position: absolute;
    top: 0;
    left: 0;
  }

  .food-map-city {
    position: absolute;
    inset-block-start: 0.375rem;
    inset-inline-start: 0.375rem;
    z-index: 2;
  }

  .food-map-city select {
    padding: 0.125rem 0.25rem;
    border: 2px solid var(--border);
    outline: 0;
    color: var(--foreground);
    background: var(--background-l0);
    font-family: inherit;
    font-size: 0.6875rem;
    cursor: pointer;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .food-map-visual,
    .food-map-transition {
      transition: none;
    }
  }
</style>
