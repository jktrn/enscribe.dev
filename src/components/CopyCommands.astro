<copy-status class="sr-only" role="status"></copy-status>

<script>
  const FEEDBACK_MS = 1500
  const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>()

  const announce = (message: string) => {
    const status = document.querySelector("copy-status")
    if (!status) return
    status.textContent = ""
    requestAnimationFrame(() => {
      status.textContent = message
    })
  }

  const write = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text)
      announce("Copied")
      return true
    } catch {
      announce("Copy failed")
      return false
    }
  }

  const copy = async (pill: HTMLElement) => {
    const text = pill.dataset.copy
    if (!text) return
    const outcome = (await write(text)) ? "data-copied" : "data-failed"
    pill.removeAttribute("data-copied")
    pill.removeAttribute("data-failed")
    pill.setAttribute(outcome, "")
    clearTimeout(timers.get(pill))
    timers.set(
      pill,
      setTimeout(() => pill.removeAttribute(outcome), FEEDBACK_MS),
    )
  }

  document.addEventListener("click", (event) => {
    const pill = (event.target as Element).closest?.("copy-command")
    if (pill instanceof HTMLElement) copy(pill)
  })

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return
    const pill = event.target
    if (!(pill instanceof HTMLElement) || pill.tagName !== "COPY-COMMAND")
      return
    event.preventDefault()
    copy(pill)
  })

  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest?.("[data-copy-page]")
    if (!(button instanceof HTMLElement) || !button.dataset.href) return
    let copied = false
    try {
      copied = await write(await (await fetch(button.dataset.href)).text())
    } catch {
      announce("Copy failed")
    }
    const original = button.textContent
    button.textContent = copied ? "Copied" : "Copy failed"
    setTimeout(() => {
      button.textContent = original
    }, FEEDBACK_MS)
  })
</script>
