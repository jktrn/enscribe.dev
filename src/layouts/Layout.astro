---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/theme-toggle.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/typography-math.css"
import "@/styles/callout.css"
import "@/styles/steps.css"
import "@/styles/cards.css"
import "@/styles/file-tree.css"
import "@/styles/tabs.css"
import "@/styles/layout.css"
import "@/styles/reference.css"
import "@/styles/scroll-fade.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"

import CopyCommands from "@/components/CopyCommands.astro"
import ProseJustification from "@/components/ProseJustification.astro"
import TabGroups from "@/components/TabGroups.astro"
import ScrollFade from "@/components/ScrollFade.astro"
import ScrollGuard from "@/components/ScrollGuard.astro"
import Search from "@/components/Search.astro"
import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import { SITE } from "@/consts"
import type { InlineLabel } from "@/lib/content"

type Props = {
  crumbs?: { label: InlineLabel; href: string }[]
  wide?: boolean
}

const { crumbs, wide } = Astro.props
const actions = Astro.slots.has("actions")
const hasToc = Astro.slots.has("toc") && !wide
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <page-grid data-toc={hasToc || undefined}>
      <page-header>
        <page-nav>
          <Sidebar crumbs={crumbs} actions={actions}
            ><slot name="actions" slot="actions" /></Sidebar
          >
        </page-nav>
        {hasToc && (
            <page-toc><slot name="toc" /></page-toc>
          )}
      </page-header>
      <page-content data-wide={wide || undefined}>
        <main><slot /></main>
        <page-footer><Footer /></page-footer>
      </page-content>
    </page-grid>
    <CopyCommands />
    <ProseJustification />
    <TabGroups />
    <ScrollFade />
    <ScrollGuard />
    <Search />
  </body>
</html>

<style>
  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);

    @media (width >= 48rem) and (width < 64rem) {
      grid-template-columns:
        max(calc(2 * var(--grid-column-width) + var(--grid-gutter)), 9rem)
        minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "nav toc" "nav content";

      &:not([data-toc]) {
        grid-template-areas: "nav content" "nav content";
      }
    }

    @media (width < 48rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-block-start: 0;
    }
  }

  page-header {
    display: contents;

    @media (width < 48rem) {
      display: block;
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      min-width: 0;
      margin-inline: calc(-1 * var(--grid-gutter));
    }
  }

  page-nav {
    display: block;
    min-width: 0;
    grid-column: 1 / 3;
    grid-row: 1;

    @media (width >= 48rem) and (width < 64rem) {
      grid-area: nav;
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-start: var(--grid-edge);
      width: max(calc(2 * var(--grid-column-width) + var(--grid-gutter)), 9rem);
    }

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-start: var(--grid-edge);
      width: calc(2 * var(--grid-column-width) + var(--grid-gutter));
    }
  }

  page-toc {
    display: block;
    min-width: 0;
    grid-column: 10 / 13;
    grid-row: 1;

    @media (width >= 48rem) and (width < 64rem) {
      grid-area: toc;
      position: sticky;
      top: 0;
      z-index: 10;
      max-inline-size: var(--measure);

      :global([data-bar]) {
        --bar-border-image: none;

        padding-inline: 0;
      }
    }

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-end: var(--grid-edge);
      width: calc(3 * var(--grid-column-width) + 2 * var(--grid-gutter));
    }
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: 3 / 10;
    grid-row: 1;
    min-width: 0;
    margin-block-start: -0.1em;

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }

    @media (width < 64rem) {
      &:not([data-wide]) {
        max-inline-size: var(--measure);
      }
    }

    @media (width >= 48rem) and (width < 64rem) {
      grid-area: content;
    }

    @media (width < 48rem) {
      grid-column: 1 / -1;
      grid-row: auto;
      inline-size: 100%;
      margin-inline: auto;
    }
  }

  @media (width >= 64rem) {
    page-grid:not([data-toc]) page-content:not([data-wide]) {
      grid-column: 3 / 13;
      /* Cap at the article rail (columns 3–10) at the grid's resting width,
         so TOC-less pages hold a constant measure that matches article pages
         at rest instead of tracking the mid-band TOC squeeze. Uses the
         gutter's resting value — the live gutter is viewport-fluid and would
         make this cap drift, re-typesetting prose on every resize tick. */
      max-inline-size: calc(
        7 *
        ((var(--grid-max-width) - 13 * var(--grid-gutter-max)) / 12) +
        6 *
        var(--grid-gutter-max)
      );
    }

    page-content[data-wide] {
      grid-column: 3 / 13;
    }
  }
</style>
