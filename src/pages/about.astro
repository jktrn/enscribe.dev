---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { Content } from "./_about.md"
---

<Layout crumbs={[{ label: "About", href: "/about" }]}>
  <MetaPage slot="head" title="About" />
  <article data-url="/about">
    <prose-content data-linebreak-root>
      <Content />
    </prose-content>
  </article>
</Layout>

<style>
  :global(.awesome-colors) {
    --awesome-from: light-dark(#b21e59, #ff9592);
    --awesome-to: light-dark(#825000, #f5e147);

    color: var(--awesome-from);

    @supports (background-clip: text) {
      background-image: linear-gradient(
        90deg,
        var(--awesome-from),
        var(--awesome-to)
      );
      background-clip: text;
      color: transparent;
    }
  }
</style>
