---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { Content } from "./_about.md"
---

<Layout crumbs={[{ label: "About", href: "/about" }]}>
  <MetaPage slot="head" title="About" />
  <article data-url="/about">
    <prose-content data-prose-root>
      <Content />
    </prose-content>
  </article>
</Layout>

<style>
  :global(.buttons-88x31) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);

    :global(copy-command) {
      position: relative;
      display: block;
      cursor: copy;

      &::after {
        content: "Copied!";
        position: absolute;
        inset-block-end: calc(100% + var(--space-3xs));
        inset-inline-start: 50%;
        translate: -50% var(--space-3xs);
        padding: var(--space-3xs) var(--space-2xs);
        border-radius: var(--radius-sm);
        background-color: var(--primary);
        color: var(--primary-foreground);
        font-size: var(--step--1);
        line-height: 1;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transition:
          opacity 0.15s ease,
          translate 0.15s ease;
      }

      &:global([data-copied])::after {
        translate: -50% 0;
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        &::after {
          translate: -50% 0;
        }
      }
    }

    :global(img) {
      margin-inline: 0;
      image-rendering: pixelated;
    }
  }

  :global(.awesome-colors) {
    --awesome-from: light-dark(#b21e59, #ff9592);
    --awesome-to: light-dark(#825000, #f5e147);

    color: var(--awesome-from);

    @supports (background-clip: text) {
      background-image: linear-gradient(
        90deg,
        var(--awesome-from),
        var(--awesome-to)
      );
      background-clip: text;
      color: transparent;
    }
  }
</style>
