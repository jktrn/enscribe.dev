{
  "name": "@enscribe/linebreak-tests",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run test:unit && bun run test:browser",
    "test:unit": "bun test unit",
    "test:package": "bun test package",
    "test:e2e": "bun run --cwd ../.. build && playwright test --config e2e/playwright.config.ts",
    "check": "bun run typecheck && bun run test:unit && bun run test:package && bun run test:e2e",
    "test:browser": "vitest run --config vitest.config.mjs --project browser",
    "coverage": "vitest run --config vitest.config.mjs --coverage"
  },
  "dependencies": {
    "@enscribe/linebreak": "workspace:*"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.8",
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "typescript": "6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.14.0"
  }
}
